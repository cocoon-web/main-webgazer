<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAIN-WebGazer v3.2 - Protocolo de Narrativa + Eye-tracking</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; text-align: center; margin: 0; padding: 20px; background: #f0f2f5; }
        #status { font-size: 1.2em; min-height: 50px; margin: 20px; padding: 15px; background: white; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .btn { padding: 15px 30px; font-size: 16px; margin: 10px; border: none; border-radius: 5px; cursor: pointer; transition: 0.3s; }
        #startBtn { background: #27ae60; color: white; }
        #stopBtn { background: #e74c3c; color: white; display: none; }
        #main-slideshow { display: none; max-width: 1000px; margin: auto; border: 5px solid #fff; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
        .swiper-slide img { width: 100%; height: auto; display: block; }
        
        /* Calibración personalizada */
        .calib-point {
            position: fixed; width: 25px; height: 25px; background: #e74c3c;
            border-radius: 50%; border: 3px solid white; cursor: pointer; z-index: 4000;
        }
    </style>
</head>
<body>

    <h1>MAIN-WebGazer: Social Cognition Biometrics</h1>
    <div id="status">Presione INICIAR para comenzar el protocolo neuro-afirmativo</div>

    <button id="startBtn" class="btn" onclick="startProtocol()">INICIAR PROTOCOLO</button>
    <button id="stopBtn" class="btn" onclick="endProtocol()">FINALIZAR Y EXPORTAR</button>

    <div id="main-slideshow" class="swiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide"><img src="main_img/cat-picture1.png" alt="S1"></div>
            <div class="swiper-slide"><img src="main_img/cat-picture2.png" alt="S2"></div>
            <div class="swiper-slide"><img src="main_img/cat-picture3.png" alt="S3"></div>
            <div class="swiper-slide"><img src="main_img/cat-picture4.png" alt="S4"></div>
            <div class="swiper-slide"><img src="main_img/cat-picture5.png" alt="S5"></div>
            <div class="swiper-slide"><img src="main_img/cat-picture6.png" alt="S6"></div>
        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
    </div>

    <script src="webgazer.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script>
        let participantID, webgazerData = [], audioChunks = [], mediaRecorder;
        let pointsToCalibrate = 9, clicksPerPoint = 5;

        async function startProtocol() {
            participantID = prompt("ID Participante:", "SUBJ_" + Date.now().toString().slice(-4)) || "PILOT";
            document.getElementById('startBtn').style.display = 'none';
            
            // 1. Iniciar Audio
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            mediaRecorder = new MediaRecorder(stream);
            mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
            mediaRecorder.onstop = () => saveFile(new Blob(audioChunks), `${participantID}_audio.webm`, 'audio/webm');
            mediaRecorder.start();

            // 2. Iniciar WebGazer [cite: 99]
            await webgazer.setGazeListener((data) => {
                if (data) {
                    webgazerData.push({ t: Date.now(), x: data.x, y: data.y, slide: (window.swiper ? swiper.activeIndex + 1 : 0) });
                }
            }).begin();
            
            webgazer.showVideoPreview(false).showPredictionPoints(true);
            runCalibration();
        }

        function runCalibration() {
            document.getElementById('status').textContent = "Calibración: Haz clic 5 veces en cada punto rojo";
            const coords = [
                [10,10], [50,10], [90,10],
                [10,50], [50,50], [90,50],
                [10,90], [50,90], [90,90]
            ];
            
            let currentIdx = 0;
            const createPoint = (idx) => {
                if (idx >= coords.length) {
                    finishCalibration();
                    return;
                }
                const p = document.createElement('div');
                p.className = 'calib-point';
                p.style.left = coords[idx][0] + '%';
                p.style.top = coords[idx][1] + '%';
                let clicks = 0;
                p.onclick = () => {
                    clicks++;
                    p.style.opacity = 1 - (clicks * 0.2);
                    if (clicks >= clicksPerPoint) {
                        p.remove();
                        createPoint(++currentIdx);
                    }
                };
                document.body.appendChild(p);
            };
            createPoint(0);
        }

        function finishCalibration() {
            webgazer.showPredictionPoints(false);
            document.getElementById('status').textContent = "Protocolo MAIN en curso: Narración activa";
            document.getElementById('main-slideshow').style.display = 'block';
            document.getElementById('stopBtn').style.display = 'inline-block';
            
            window.swiper = new Swiper('.swiper', {
                navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
            });
        }

        function endProtocol() {
            webgazer.pause();
            mediaRecorder.stop();
            const csv = "timestamp,x,y,slide\n" + webgazerData.map(d => `${d.t},${d.x},${d.y},${d.slide}`).join("\n");
            saveFile(csv, `${participantID}_gaze.csv`, 'text/csv');
            document.getElementById('status').textContent = "Sesión finalizada. Archivos descargados.";
        }

        function saveFile(content, name, type) {
            const blob = (content instanceof Blob) ? content : new Blob([content], { type });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = name; a.click();
        }
    </script>

    <canvas id="heatmap-canvas" style="display:none; position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:100;"></canvas>

<script>
    let heatmapVisible = false;

    // Función para dibujar el Heatmap basado en los datos de la sesión
    function generateHeatmap() {
        const canvas = document.getElementById('heatmap-canvas');
        const ctx = canvas.getContext('2d');
        const container = document.getElementById('main-slideshow');
        
        // Ajustar canvas al tamaño actual del contenedor
        canvas.width = container.offsetWidth;
        canvas.height = container.offsetHeight;
        canvas.style.display = 'block';

        const currentSlide = swiper.activeIndex + 1;
        const slideData = webgazerData.filter(d => d.slide === currentSlide);

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        // Dibujar puntos con gradiente radial para efecto de calor
        slideData.forEach(point => {
            // Ajuste de coordenadas relativas al contenedor
            const rect = container.getBoundingClientRect();
            const x = point.x - rect.left;
            const y = point.y - rect.top;

            const gradient = ctx.createRadialGradient(x, y, 2, x, y, 20);
            gradient.addColorStop(0, 'rgba(255, 0, 0, 0.4)');
            gradient.addColorStop(1, 'rgba(255, 255, 0, 0)');
            
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(x, y, 20, 0, Math.PI * 2);
            ctx.fill();
        });
        
        status.textContent = `Visualizando Heatmap - Slide ${currentSlide}. Presione FINALIZAR para ocultar.`;
    }

    // Modificamos endProtocol para ofrecer la revisión antes de cerrar
    function endProtocol() {
        webgazer.pause();
        if (mediaRecorder && mediaRecorder.state !== "inactive") mediaRecorder.stop();
        
        // Mostrar opción de revisión
        document.getElementById('status').textContent = "Sesión completada. Generando visualización de datos...";
        generateHeatmap();
        
        // Exportar automáticamente los archivos
        exportCSV();
    }

    function exportCSV() {
        const csvContent = "timestamp,x,y,slide\n" + 
            webgazerData.map(d => `${d.t},${d.x},${d.y},${d.slide}`).join("\n");
        saveFile(csvContent, `${participantID}_gaze_data.csv`, 'text/csv');
    }
</script>
</body>
</html>
