<canvas id="heatmap-canvas" style="display:none; position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:100;"></canvas>

<script>
    let heatmapVisible = false;

    // Función para dibujar el Heatmap basado en los datos de la sesión
    function generateHeatmap() {
        const canvas = document.getElementById('heatmap-canvas');
        const ctx = canvas.getContext('2d');
        const container = document.getElementById('main-slideshow');
        
        // Ajustar canvas al tamaño actual del contenedor
        canvas.width = container.offsetWidth;
        canvas.height = container.offsetHeight;
        canvas.style.display = 'block';

        const currentSlide = swiper.activeIndex + 1;
        const slideData = webgazerData.filter(d => d.slide === currentSlide);

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        // Dibujar puntos con gradiente radial para efecto de calor
        slideData.forEach(point => {
            // Ajuste de coordenadas relativas al contenedor
            const rect = container.getBoundingClientRect();
            const x = point.x - rect.left;
            const y = point.y - rect.top;

            const gradient = ctx.createRadialGradient(x, y, 2, x, y, 20);
            gradient.addColorStop(0, 'rgba(255, 0, 0, 0.4)');
            gradient.addColorStop(1, 'rgba(255, 255, 0, 0)');
            
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(x, y, 20, 0, Math.PI * 2);
            ctx.fill();
        });
        
        status.textContent = `Visualizando Heatmap - Slide ${currentSlide}. Presione FINALIZAR para ocultar.`;
    }

    // Modificamos endProtocol para ofrecer la revisión antes de cerrar
    function endProtocol() {
        webgazer.pause();
        if (mediaRecorder && mediaRecorder.state !== "inactive") mediaRecorder.stop();
        
        // Mostrar opción de revisión
        document.getElementById('status').textContent = "Sesión completada. Generando visualización de datos...";
        generateHeatmap();
        
        // Exportar automáticamente los archivos
        exportCSV();
    }

    function exportCSV() {
        const csvContent = "timestamp,x,y,slide\n" + 
            webgazerData.map(d => `${d.t},${d.x},${d.y},${d.slide}`).join("\n");
        saveFile(csvContent, `${participantID}_gaze_data.csv`, 'text/csv');
    }
</script>
